---
// Screenshots made by the app's own screenshot mode (FERROCAST_SCREENSHOT) on sample files.
// Captions say what each window does.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const W = 1500;
const H = 950;
const shots: { id: string; name: string; alt: string; caption: string }[] = [
  { id: 'wheel-convert', name: 'Convert wheel (dark)', alt: 'The convert wheel in the dark theme for a PNG file, with JPEG, WebP, HEIC, TIFF, AVIF, BMP and PDF segments and WebP highlighted', caption: 'The Convert wheel for a PNG: one segment per target format, the highlighted one named in the centre.' },
  { id: 'wheel-tools', name: 'Tools wheel (dark)', alt: 'The tools wheel in the dark theme for a PNG file, with Compress, Metadata, Edit Photo, Annotate, Background, Crop and Redact segments', caption: 'The Tools wheel for an image: each segment opens a window or runs a preset.' },
  { id: 'wheel-tools-video', name: 'Tools wheel for a video (dark)', alt: 'The tools wheel in the dark theme for an MP4 video with nine labelled segments: Compress, Metadata, Mute, Trim, Crop Video, Speed, Snapshots, Split and Redact Video', caption: 'The Tools wheel for a video has nine segments, each with its name under the icon. Long names are shortened to fit the ring.' },
  { id: 'wheel-actions', name: 'Actions wheel (dark)', alt: 'The actions wheel in the dark theme with seven segments: AirDrop, Float, Copy, Move to, Copy Path, Terminal and Zip', caption: 'The Actions wheel: AirDrop, Float shelf, Copy, Move to, Copy Path, Terminal and Zip.' },
  { id: 'wheel-convert-light', name: 'Convert wheel (light)', alt: 'The convert wheel in the light theme for a PNG file with WebP highlighted', caption: 'The same Convert wheel in the light theme.' },
  { id: 'vtrim', name: 'Trim Video', alt: 'The Trim Video window showing a test-pattern frame, start and end marks on a timeline and the clip length', caption: 'Trim Video: a preview frame, start and end marks on a timeline, and the clip length.' },
  { id: 'vcrop', name: 'Crop Video', alt: 'The Crop Video window with a square crop box over a test-pattern frame and ratio presets', caption: 'Crop Video: a crop box over a preview frame, with ratio presets and exact width and height.' },
  { id: 'vspeed', name: 'Change Video Speed', alt: 'The Change Video Speed window with speed presets from 0.25x to 4x and a 6 second to 3 second duration readout', caption: 'Change Video Speed: presets or a slider, with the new length shown.' },
  { id: 'vsnapshot', name: 'Video Snapshots', alt: 'The Video Snapshots window showing a test-pattern frame and a timeline', caption: 'Video Snapshots: step to a frame and save it as a full-resolution PNG.' },
  { id: 'vsplit', name: 'Split Video', alt: 'The Split Video window with two cut marks on a timeline giving three clips', caption: 'Split Video: cut marks on a timeline, or equal parts when no cuts are set.' },
  { id: 'vredact', name: 'Redact Video', alt: 'The Redact Video window with three numbered cover areas over a test-pattern frame, a list of areas with time ranges, Solid and Blur modes and a reference frame slider', caption: 'Redact Video: several areas, each with its own start and end time and a solid or blur cover. The preview only marks the areas; the cover is applied when the copy is saved.' },
  { id: 'atrim', name: 'Trim Audio', alt: 'The Trim Audio window with a waveform, a selected range from 1 to 4 seconds and a Trim silence button', caption: 'Trim Audio: a waveform with a selected range, typed start and end times, and a Trim silence button.' },
  { id: 'anorm', name: 'Normalize Audio', alt: 'The Normalize Audio window showing the measured loudness, target presets and loudness range and true peak fields', caption: 'Normalize Audio: measured loudness, target presets for broadcast, podcast and music, and range and peak fields.' },
  { id: 'achan', name: 'Audio Channels', alt: 'The Audio Channels window with Mono and Stereo choices and left and right volume fields', caption: 'Audio Channels: Mono or Stereo, with a volume in dB for each side.' },
  { id: 'avis', name: 'Audio to Video', alt: 'The Audio to Video window for an MP3 with Waveform and Still image choices and Landscape, Portrait and Square shapes, Portrait selected', caption: 'Audio to Video: a moving waveform or one still image on a landscape, portrait or square canvas. The window shows the chosen settings, not a preview of the video.' },
  { id: 'avis-light', name: 'Audio to Video (light)', alt: 'The Audio to Video window in the light theme with the same Waveform and Portrait choices in grouped cards', caption: 'The same window in the light theme, to show that the grouped cards and the footer keys read in both themes.' },
  { id: 'bleep', name: 'Bleep Audio', alt: 'The Bleep Audio window with a waveform, three shaded ranges numbered 1 to 3 with range 2 selected, a range list and start and end fields', caption: 'Bleep Audio: ranges marked on the waveform and listed beside it, with typed start and end times. Overlapping ranges are merged; a copy is saved.' },
  { id: 'compress-image', name: 'Compress Images', alt: 'The Compress Images window with Size, Percent and Preset modes, a target size and a resize option', caption: 'Compress Images: aim for a size, a percentage or a preset. The size shown is a rough estimate, not a measurement.' },
  { id: 'compress-video', name: 'Compress Audio and Video', alt: 'The Compress Audio and Video window for an MP4 with a target size and the bitrates it would use', caption: 'Compress Audio and Video: the same goals for media files, with the bitrates a target would use.' },
  { id: 'meta', name: 'Edit Metadata', alt: 'The Edit Metadata window listing artist, comment and title tags of a video with clear buttons and a Remove all metadata option', caption: 'Edit Metadata: tags read from the file, editable or clearable, or remove them all. A copy is saved.' },
  { id: 'reorder', name: 'Choose Order', alt: 'The Choose Order window listing two PDF files with move up and move down buttons', caption: 'Choose Order: set the order of files before merging PDFs, joining videos or merging audio.' },
  { id: 'crop', name: 'Crop Image', alt: 'The Crop Image window with a 4 to 3 crop box over a picture and ratio presets', caption: 'Crop Image: a crop box with ratio presets and exact width and height.' },
  { id: 'edit', name: 'Edit Photo', alt: 'The Edit Photo window with a picture and sliders for brightness, contrast, saturation, warmth, clarity, sharpen, grain, denoise and dehaze', caption: 'Edit Photo: nine sliders and a preview on a reduced copy; saving writes a full-size copy.' },
  { id: 'redact', name: 'Redact Image', alt: 'The Redact Image window with two cover areas over a picture, Solid and Blur modes and colour choices', caption: 'Redact Image: cover areas on the picture, solid or blur, applied when the copy is saved.' },
  { id: 'frame', name: 'Add Background', alt: 'The Add Background window with a picture on a blue backdrop and sliders for padding, corners and shadow', caption: 'Add Background: padding, corner radius and shadow on a colour or blurred backdrop.' },
  { id: 'collage', name: 'Make a Collage', alt: 'The Make a Collage window with three pictures in a featured layout on a blue background and layout, spacing and corner controls', caption: 'Make a Collage: Grid, Row, Column or Featured layouts with spacing, corners and a background colour.' },
  { id: 'organize', name: 'Organize PDF', alt: 'The Organize PDF window with page thumbnails of a three-page PDF, one rotated and one duplicated', caption: 'Organize PDF: page thumbnails you can rotate, duplicate, remove and reorder. Here page 2 was rotated and duplicated.' },
  { id: 'annotate', name: 'Annotate Image', alt: 'The Annotate Image window with a picture marked with an arrow, a box, a number, a callout, a text label and a magnifier, and a row of tools', caption: 'Annotate Image: arrows, boxes, numbers, callouts, text and a magnifier, shown here with sample marks already placed.' },
];
---
<ul class="gl">
  {shots.map((s) => (
    <li>
      <figure class="gl-fig">
        <img src={`${base}/img/files-${s.id}.jpg`} width={W} height={H} loading="lazy" decoding="async" alt={s.alt} />
        <figcaption><b>{s.name}</b><span>{s.caption}</span></figcaption>
      </figure>
    </li>
  ))}
</ul>
