---
import Base from '../../layouts/Base.astro';
import SiteHeader from '../SiteHeader.astro';
import SiteFooter from '../SiteFooter.astro';
import Crumbs from './Crumbs.astro';
import { installCommand as brewBlock } from '../../data/install';
import { pairFacts, pairMeta, relatedPairs, type Pair } from '../../lib/seo/convert';
import { breadcrumbs, howTo, SITE } from '../../lib/seo/jsonld';
import { esFor } from '../../lib/seo/convert-es';
import { pairGuides } from '../../lib/seo/pair-guides';
import { inline, plain } from '../../lib/seo/markup';
import Shots from './Shots.astro';
import '../../styles/seo.css';

interface Props { pair: Pair }
const { pair: p } = Astro.props;
const guide = pairGuides[p.slug];
const meta = { ...pairMeta(p), ...(guide?.title && { title: guide.title }), ...(guide?.description && { description: guide.description }) };
const facts = pairFacts(p);
const rel = relatedPairs(p);
const canonical = `${SITE}/convert/${p.slug}/`;
const es = esFor(p.slug);
const alternates = es ? { en: canonical, es: `${SITE}/es/convertir/${es.slug}/`, 'x-default': canonical } : undefined;
const crumbs: [string, string][] = [['Home', '/'], ['Files', '/files/'], [p.familyName, `/convert/${p.family}/`], [`${p.inLabel} to ${p.outLabel}`, `/convert/${p.slug}/`]];
const steps: [string, string][] = [
  ['Install Ferrocast', 'Install it with Homebrew; it builds on your Mac.'],
  [`Drag your ${p.inLabel} file`, 'Start dragging the file from Finder, or select it in the launcher.'],
  ['Tap Shift', `Tap ⇧ to open the conversion wheel, or press ⌥↵ on a file result in the launcher.`],
  [`Release over ${p.outLabel}`, 'The result is saved next to the original and never overwrites it.'],
];
const faq: [string, string][] = [
  [`Is my ${p.inLabel} file uploaded anywhere?`, 'No. Conversions run on your Mac; nothing is uploaded.'],
  ['Will it overwrite my original?', 'No. The result is written next to the original with the same name and the new extension. If that name is taken it adds 2, 3 and so on.'],
  ['Do I need to install anything besides Ferrocast?', facts.requirement],
];
if (guide) faq.push(...guide.faq);
if (guide?.question) faq.unshift([guide.question, guide.lead]);
const jsonLd: object[] = [breadcrumbs(crumbs), howTo(`Convert ${p.inLabel} to ${p.outLabel} on Mac`, meta.description, steps)];
// The FAQ block is marked up only on pages with a written guide, where the answers were checked by hand.
if (guide) jsonLd.push({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: plain(a) } })) });
---
<Base title={meta.title} description={meta.description} canonical={canonical} jsonLd={jsonLd} alternates={alternates}>
  <SiteHeader current="files" switchHref={es ? `/es/convertir/${es.slug}/` : undefined} switchAria="Leer esta página en español" />
  <main class="seo" id="main">
    <Crumbs items={crumbs} />
    <h1 class="pair-title">{guide?.h1 ?? `${p.inLabel} to ${p.outLabel} on your Mac, without uploading`}</h1>
    {guide ? <p class="lead" set:html={inline(guide.lead)} /> : <p class="lead">Convert {p.inLabel} files to {p.outLabel} with Ferrocast. The conversion runs on your Mac and the result is saved next to the original.</p>}
    <h2>How to convert {p.inLabel} to {p.outLabel}</h2>
    <ol>
      <li>Install Ferrocast (below).</li>
      <li>Drag your {p.inLabel} file, or select it in the launcher.</li>
      <li>Tap <kbd>⇧</kbd> for the conversion wheel (or press <kbd>⌥</kbd><kbd>↵</kbd> on a file result).</li>
      <li>Release over <strong>{p.outLabel}</strong>. The copy is saved beside the original.</li>
    </ol>
    <Shots path={`/convert/${p.slug}/`} where="steps" />
    <h2>What this pair needs</h2>
    <p>{facts.requirement}</p>
    {facts.limits.length > 0 && (<>
      <h2>Limits</h2>
      <ul>{facts.limits.map((l) => <li>{l}</li>)}</ul>
    </>)}
    {guide && guide.sections.map((sec) => (
      <>
        <h2>{sec.h}</h2>
        {sec.paras?.map((x) => <p set:html={inline(x)} />)}
        {sec.list && <ul>{sec.list.map((x) => <li set:html={inline(x)} />)}</ul>}
        {sec.code && <pre><code>{sec.code}</code></pre>}
      </>
    ))}
    <h2>Install Ferrocast</h2>
    <pre><code>{brewBlock}</code></pre>
    <p>Free, open source (MIT), Apple Silicon only. <a class="tl" href="/docs/getting-started/install/">Install guide</a> · <a class="tl" href="/docs/files/conversions/">All conversions in the docs</a></p>
    <h2>Related conversions</h2>
    <ul class="chips">
      {rel.reverse && <li><a href={`/convert/${rel.reverse.slug}/`}>{rel.reverse.inLabel} to {rel.reverse.outLabel}</a></li>}
      {rel.sameInput.map((q) => <li><a href={`/convert/${q.slug}/`}>{q.inLabel} to {q.outLabel}</a></li>)}
      {rel.sameOutput.map((q) => <li><a href={`/convert/${q.slug}/`}>{q.inLabel} to {q.outLabel}</a></li>)}
    </ul>
    <p><a class="tl" href={`/convert/${p.family}/`}>All {p.familyName.toLowerCase()} conversions</a> · <a class="tl" href="/tools/">File tools</a> · <a class="tl" href="/files/">Explore all 275 conversions</a></p>
    <h2>Questions</h2>
    {faq.map(([q, a]) => (<div><h3>{q}</h3><p set:html={inline(a)} /></div>))}
  </main>
  <SiteFooter />
</Base>
