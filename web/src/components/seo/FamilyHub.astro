---
import Base from '../../layouts/Base.astro';
import SiteHeader from '../SiteHeader.astro';
import SiteFooter from '../SiteFooter.astro';
import Crumbs from './Crumbs.astro';
import { familyHubs } from '../../lib/seo/convert';
import { breadcrumbs, SITE } from '../../lib/seo/jsonld';
import '../../styles/seo.css';

interface Props { id: string }
const hub = familyHubs().find((f) => f.id === Astro.props.id)!;
const total = hub.inputs.reduce((n, i) => n + i.outputs.length, 0);
const canonical = `${SITE}/convert/${hub.id}/`;
const crumbs: [string, string][] = [['Home', '/'], ['Files', '/files/'], [hub.name, `/convert/${hub.id}/`]];
const title = `Convert ${hub.name} on Mac, local and offline · Ferrocast`;
const description = `Convert ${hub.name} on your Mac: ${total} conversions from ${hub.inputs.length} input formats, run locally with Ferrocast. Nothing is uploaded; pick a format.`;
if (title.length > 60 || description.length < 120 || description.length > 155) throw new Error(`hub meta out of range for ${hub.id}: ${title.length}/${description.length}`);
---
<Base title={title} description={description} canonical={canonical} jsonLd={breadcrumbs(crumbs)}>
  <SiteHeader current="files" />
  <main class="seo" id="main">
    <Crumbs items={crumbs} />
    <h1>Convert {hub.name} on your Mac</h1>
    <p class="lead">{total} conversions from {hub.inputs.length} input formats. They run locally with Ferrocast; the result is saved next to the original.</p>
    {hub.inputs.map((i) => (
      <section>
        <h2>From {i.label}</h2>
        <ul class="chips">{i.outputs.map((o) => <li><a href={`/convert/${i.ext.toLowerCase()}-to-${o.ext.toLowerCase()}/`}>{i.label} to {o.label}</a></li>)}</ul>
      </section>
    ))}
    {hub.id === 'pdf' && <p><a class="tl" href="/tools/organize-pdf/">Reorder pages inside one PDF</a></p>}
    <p><a class="tl" href="/files/">Explore all 275 conversions</a> · <a class="tl" href="/#install">Install Ferrocast</a></p>
  </main>
  <SiteFooter />
</Base>
