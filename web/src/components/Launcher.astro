---
const rows = [
  { ic: '🧮', t: '100 usd in eur', s: '≈ 92,41 EUR', hot: true },
  { ic: '🕐', t: '5pm ldn in sf', s: '9:00 a. m. · San Francisco' },
  { ic: '📋', t: 'Clipboard History', s: 'Comando · ⌘⇧V' },
  { ic: '🪟', t: 'Left Half', s: 'Gestión de ventanas · ⌃⌥←' },
  { ic: '✨', t: 'Ask AI', s: 'Ollama · local' },
];
---
<div class="launcher" aria-label="Maqueta del launcher de Ferrocast">
  <div class="bar"><span class="q">100 usd in eur</span><kbd>⌥ Space</kbd></div>
  <ul>
    {rows.map((r) => (
      <li class:list={[{ hot: r.hot }]}>
        <span class="ic">{r.ic}</span>
        <span class="tx"><b>{r.t}</b><small>{r.s}</small></span>
        {r.hot && <kbd>↵</kbd>}
      </li>
    ))}
  </ul>
</div>
<style>
  .launcher { background: var(--panel); border: 1px solid var(--line); border-radius: 18px; box-shadow: 0 40px 100px -20px rgba(255,106,43,.25), 0 0 0 1px #000; overflow: hidden; max-width: 560px; margin-inline: auto; }
  .bar { display: flex; justify-content: space-between; align-items: center; padding: 18px 20px; border-bottom: 1px solid var(--line); font-size: 1.25rem; }
  .q::after { content: ''; display: inline-block; width: 2px; height: 1.1em; background: var(--accent); margin-left: 3px; vertical-align: -3px; animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  ul { list-style: none; padding: 8px; }
  li { display: flex; align-items: center; gap: 14px; padding: 10px 12px; border-radius: 10px; }
  li.hot { background: #1f1f26; }
  .ic { font-size: 1.4rem; width: 32px; text-align: center; }
  .tx { display: flex; flex-direction: column; flex: 1; }
  .tx small { color: var(--mute); }
</style>
