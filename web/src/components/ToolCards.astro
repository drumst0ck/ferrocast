---
import tools from '../data/tools.json';
import { toolLevel } from '../data/status';
import StatusBadge from './StatusBadge.astro';

const byId = new Map(tools.tools.map((t) => [t.id, t]));
const groups: { name: string; blurb: string; ids: string[] }[] = [
  { name: 'Image editors', blurb: 'For JPEG, PNG, WebP, HEIC and TIFF. Originals are never overwritten.', ids: ['editImage', 'annotateImage', 'frameImage', 'cropImage', 'redactImage', 'createCollage', 'createPdf'] },
  { name: 'Video windows', blurb: 'For MP4, MOV and MKV. Preview frames and re-encoding need ffmpeg.', ids: ['trimVideo', 'cropVideo', 'changeVideoSpeed', 'videoSnapshots', 'splitVideo', 'redactVideo', 'joinVideos', 'muteVideo'] },
  { name: 'PDF organizer and metadata', blurb: 'Reorder, split and merge PDFs, and read or change tags on files.', ids: ['organizePdf', 'mergePdf', 'splitPdf', 'removeMetadata'] },
  { name: 'Audio tools', blurb: 'For MP3, M4A, WAV and FLAC. These use ffmpeg.', ids: ['normalizeAudio', 'trimAudio', 'audioChannels', 'audioToVideo', 'redactAudio'] },
  { name: 'Archives and compression', blurb: 'Make files smaller, or unpack an archive into a new folder next to it.', ids: ['compress', 'extractArchive'] },
];
const grouped = new Set(groups.flatMap((g) => g.ids));
for (const t of tools.tools) if (!grouped.has(t.id)) throw new Error(`tool ${t.id} is not in any card group`);
for (const id of grouped) if (!byId.has(id)) throw new Error(`card group names unknown tool ${id}`);

// Hand-written one-liners. They say what the tool does.
const about: Record<string, string> = {
  editImage: 'Sliders for brightness, contrast, saturation, warmth, clarity, sharpen, grain, denoise and dehaze, with a preview on a smaller copy.',
  annotateImage: 'Arrows, lines, boxes, ellipses, highlights, pen, numbered labels, magnifiers, text, callouts and image stamps. Saves a PNG copy.',
  frameImage: 'Put the picture on a colour or blurred backdrop, with padding, rounded corners and a shadow.',
  cropImage: 'Drag a rectangle, lock an aspect ratio, or type exact width and height.',
  redactImage: 'Drag your own areas over the picture, or type redact faces or redact text to detect them on your Mac. Solid colour or blur.',
  createCollage: 'Grid, row, column or featured layouts with spacing, rounded corners and a background.',
  createPdf: 'Combine the selected images into one PDF, a page per image, in an order you choose.',
  trimVideo: 'Step by frame or second, set in and out markers, and write an exact re-encoded cut.',
  cropVideo: 'Drag a rectangle over a preview frame or type exact dimensions.',
  changeVideoSpeed: 'From a quarter of the speed to four times, with the new duration shown. No playback preview.',
  videoSnapshots: 'Pick frames and save them as full-resolution PNG files.',
  splitVideo: 'Add cut points on the timeline or split into equal parts. Clips land in one new folder.',
  redactVideo: 'Cover an area with a solid colour or blur for a chosen time range. One area per run.',
  joinVideos: 'Join several clips into one MP4 in an order you choose; the first clip sets the canvas.',
  muteVideo: 'Write a copy of the video without its audio track.',
  organizePdf: 'Page thumbnails: rotate, duplicate, remove and reorder pages, then save a copy.',
  mergePdf: 'Merge PDFs in the order you choose.',
  splitPdf: 'Split a PDF into one file per page.',
  removeMetadata: 'Read tags on audio, video and PDF files, edit them or remove them. Images use a lossless removal preset.',
  normalizeAudio: 'Set a target loudness, loudness range and true peak, and see the measured level first.',
  trimAudio: 'Waveform with start and end markers, exact times, and a button to trim silence at the ends.',
  audioChannels: 'Mono or stereo, with left and right volume in dB.',
  audioToVideo: 'Make an MP4 from audio with a still image. The still image is set with a typed command.',
  redactAudio: 'Bleep out a stretch of audio with a typed command.',
  compress: 'Aim for a target size, a percentage or a preset, and optionally limit the longest edge. PDF compression needs Ghostscript.',
  extractArchive: 'Unpack ZIP, TAR, GZ or RAR into a new folder named after the archive. Refuses entries that try to escape the folder.',
};
// Typed command examples that are covered by tests (README / CHANGELOG).
const typed: Record<string, string> = {
  compress: '500kb',
  frameImage: 'frame blur 40',
  createCollage: 'collage row 1600 gap 16',
  trimVideo: 'trim 0:10-0:30',
  organizePdf: 'pages 3,1,2r',
  editImage: 'edit brightness 20 grain 30',
  redactImage: 'redact faces',
  audioToVideo: 'visualizer square image /path/cover.jpg',
};

const names = Object.fromEntries(tools.tools.map((t) => [t.id, t.name]));
const rows = tools.byFormat.map((b) => ({ ext: b.ext, single: b.single.map((id) => names[id] ?? id), multi: b.multi.map((id) => names[id] ?? id) }));
---
<div class="tc">
  {groups.map((g) => (
    <div class="tc-group">
      <h3>{g.name}</h3>
      <p class="muted">{g.blurb}</p>
      <ul class="tc-cards">
        {g.ids.map((id) => {
          const t = byId.get(id)!;
          return (
            <li class="tc-card">
              <div class="tc-top"><h4>{t.name}</h4><StatusBadge level={toolLevel(t.status)} /></div>
              <p>{about[id]}</p>
              {t.shortcut && <p class="tc-key"><kbd>{t.shortcut}</kbd> <span>on a selected file in the launcher list</span></p>}
              {typed[id] && <p class="tc-typed"><span>Type</span> <code>{typed[id]}</code></p>}
              <p class="tc-fmt">{t.formats.map((e) => <span>.{e}</span>)}</p>
            </li>
          );
        })}
      </ul>
    </div>
  ))}

  <div class="tc-group" id="by-format">
    <h3>Which tools appear for which format</h3>
    <p class="muted">The wheel and the Convert list offer these tools. “Several files” is what you get with a multi-file selection.</p>
    <div class="tc-table" tabindex="0" role="region" aria-label="Tools by format, scrollable">
      <table>
        <caption class="sr-only">Tools offered for each file format</caption>
        <thead><tr><th scope="col">Format</th><th scope="col">One file</th><th scope="col">Several files</th></tr></thead>
        <tbody>
          {rows.map((r) => (
            <tr><th scope="row">.{r.ext}</th><td>{r.single.join(', ') || '—'}</td><td>{r.multi.join(', ') || '—'}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</div>
