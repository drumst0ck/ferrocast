---
interface Props { current?: string }
const { current = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repo = 'https://github.com/drumst0ck/ferrocast';
---
<header class="top">
  <a class="mark" href={`${base}/`}><img src={`${base}/icon.png`} alt="" width="30" height="30" />Ferrocast</a>
  <nav class="nav" aria-label="Main">
    <a href={`${base}/#features`}>Features</a>
    <a href={`${base}/files/`} class:list={{ on: current === 'files' }} aria-current={current === 'files' ? 'page' : undefined}>Files</a>
    <a href={`${base}/#install`}>Install</a>
    <a href={`${base}/changelog/`}>Changelog</a>
    <a href={repo}>GitHub</a>
  </nav>
  <a class="btn" href={`${base}/#install`}>Install</a>
</header>
