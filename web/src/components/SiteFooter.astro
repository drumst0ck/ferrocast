---
import FootMark from './FootMark.astro';
import GuidesNav from './GuidesNav.astro';
import { consentCopy } from '../lib/consent/copy';
interface Props { lang?: 'en' | 'es' }
const { lang = 'en' } = Astro.props;
const es = lang === 'es';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repo = 'https://github.com/drumst0ck/ferrocast';
---
<FootMark />
<footer class="foot">
  <GuidesNav lang={lang} />
  <span>{es ? 'Un lanzador rápido para macOS' : 'A fast launcher for macOS'}</span>
  <nav aria-label={es ? 'Enlaces' : 'Links'}><a href={`${base}${es ? '/es/' : '/'}`}>{es ? 'Inicio' : 'Home'}</a><a href={`${base}${es ? '/es/files/' : '/files/'}`}>{es ? 'Convertir archivos' : 'Convert & file tools'}</a><a href={`${base}${es ? '/es/alternativa-a-raycast/' : '/raycast-alternative/'}`}>{es ? 'Alternativa a Raycast' : 'Raycast alternative'}</a><a href={`${base}${es ? '/es' : ''}/docs/`}>{es ? 'Documentación' : 'Docs'}</a><a href={`${base}/changelog/`}>Changelog</a><a href={repo}>GitHub</a><a href={`${repo}/blob/master/LICENSE`}>{es ? 'Licencia' : 'License'}</a><a href={`${base}${consentCopy[lang].policyHref}`} data-cookie-settings>{consentCopy[lang].settings}</a></nav>
  <span class="r">{new Date().getFullYear()} · MIT</span>
</footer>
