---
/*
 * Home "Record" section: the real editor screenshot with one live thing. A click or tap on the picture
 * zooms toward that point the way auto zoom does (src/scripts/record-zoom.js). Without script the picture is static.
 */
import type { HomeCopy } from '../../i18n/home.en';

interface Props { t: HomeCopy; lang: 'en' | 'es' }
const { t, lang } = Astro.props;
const r = t.record;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const docsHref = `${base}${lang === 'es' ? '/es' : ''}/docs/launcher/screen-capture/`;
---
<section class="rec wrap" id="record" aria-labelledby="h-rec">
  <div class="rec-head">
    <h2 id="h-rec" data-reveal>{r.title}</h2>
    <p data-reveal style="transition-delay:80ms">{r.lead}</p>
    <a class="tl rec-doc" data-reveal style="transition-delay:160ms" href={docsHref}>{r.docs} →</a>
  </div>
  <figure class="rec-fig" data-reveal style="transition-delay:120ms">
    <div class="rec-frame" data-rec-frame data-label={r.frameLabel}>
      <img src={`${base}/img/record-editor.jpg`} alt={r.frameAlt} width="1500" height="954" decoding="async" />
      <i class="rec-ring" data-rec-ring aria-hidden="true"></i>
    </div>
    <figcaption id="rec-cap">{r.caption}</figcaption>
  </figure>
  <ul class="rec-facts" aria-label={r.factsAria}>
    {r.facts.map(([h, d], i) => <li data-reveal style={`transition-delay:${(i % 4) * 70}ms`}><b>{h}</b><span>{d}</span></li>)}
  </ul>
</section>
<script>
  import '../../scripts/record-zoom.js';
</script>
