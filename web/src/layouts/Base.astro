---
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/png" href={`${base}/favicon.png`} />
  </head>
  <body>
    <slot />
  </body>
</html>
<style is:global>
  :root {
    --bg: #0b0b0d; --panel: #141418; --line: #26262d; --ink: #f2f0ea; --mute: #8d8b94;
    --accent: #ff6a2b; --accent-2: #ffb089;
    --mono: ui-monospace, 'SF Mono', Menlo, monospace;
    --sans: -apple-system, BlinkMacSystemFont, 'Inter', 'Helvetica Neue', sans-serif;
  }
  * { box-sizing: border-box; margin: 0; }
  html { scroll-behavior: smooth; }
  body { background: var(--bg); color: var(--ink); font-family: var(--sans); line-height: 1.55; -webkit-font-smoothing: antialiased; }
  a { color: inherit; }
  code, kbd { font-family: var(--mono); }
  .wrap { max-width: 1120px; margin: 0 auto; padding: 0 24px; }
  .btn { display: inline-flex; align-items: center; gap: 8px; padding: 12px 20px; border-radius: 10px; font-weight: 600; text-decoration: none; border: 1px solid var(--line); transition: transform .15s, background .15s; }
  .btn:hover { transform: translateY(-1px); }
  .btn.primary { background: var(--accent); color: #140700; border-color: var(--accent); }
  .btn.primary:hover { background: var(--accent-2); }
  kbd { background: var(--panel); border: 1px solid var(--line); border-bottom-width: 2px; border-radius: 6px; padding: 1px 7px; font-size: .9em; }
  @media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; } html { scroll-behavior: auto; } }
</style>
