---
import '../styles/base.css';
import '../styles/site.css';
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#0f0f11" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`https://drumst0ck.github.io${base}/og.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <link rel="apple-touch-icon" href={`${base}/icon.png`} />
    <link rel="icon" type="image/png" href={`${base}/favicon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Stack+Sans+Headline:wght@300&family=Stack+Sans+Text:wght@400;500&display=swap" rel="stylesheet" />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    <slot />
    <script>import '../scripts/reveal.js';</script>
  </body>
</html>
