---
import '../styles/fonts.css';
import '../styles/base.css';
import '../styles/site.css';
import DeferredGtm from '../components/analytics/DeferredGtm.astro';
import headlineLatin from '../assets/fonts/stack-sans-headline-latin.woff2?url';
import textLatin from '../assets/fonts/stack-sans-text-latin.woff2?url';
const {
  title,
  description,
  canonical,
  ogImage,
  jsonLd,
  lang = 'en',
  alternates,
  robots,
  /** Preload only the display face used by the hero H1 (lighter home LCP). */
  preloadFonts = 'both',
  jsonLdInBody = false,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {alternates && <link rel="alternate" hreflang="en" href={alternates.en} />}
    {alternates && <link rel="alternate" hreflang="es" href={alternates.es} />}
    {alternates && <link rel="alternate" hreflang="x-default" href={alternates['x-default'] ?? alternates.en} />}
    <meta name="theme-color" content="#0f0f11" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f6f6f8" media="(prefers-color-scheme: light)" />
    <meta name="color-scheme" content="dark light" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage ?? new URL(`${base}/og-welcome.jpg`, Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <link rel="apple-touch-icon" href={`${base}/icon.png`} />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="any" />
    <link rel="icon" type="image/png" href={`${base}/favicon.png`} />
    <link rel="preload" as="font" type="font/woff2" href={headlineLatin} crossorigin />
    {preloadFonts === 'both' && <link rel="preload" as="font" type="font/woff2" href={textLatin} crossorigin />}
    {!jsonLdInBody && jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KC23GXFQ" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <slot />
    {jsonLdInBody && jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <DeferredGtm />
    <script>import '../scripts/reveal.js'; import '../scripts/foot-mark.js';</script>
  </body>
</html>
