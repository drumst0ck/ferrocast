---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const img = (n: string) => `${base}/img/${n}.jpg`;
const repo = 'https://github.com/drumst0ck/ferrocast';
// Measured on the maintainer's Mac; see the method note in the Measured section. Update together.
const bench = {
  date: '2026-10-17', mac: 'MacBook with Apple M3, macOS 27', raycastVersion: '2.8.1',
  ferro: { disk: '8.5 MB', mem: '145 MB', procs: '1', start: 'about 150 ms' },
  ray: { disk: '242 MB', mem: '154 MB', procs: '4', start: 'not measured' },
};
const compare = [
  ['Price', 'Free. MIT licence.', 'Free tier; Pro subscription for AI and cloud sync.'],
  ['Account', 'None.', 'Optional; needed for Pro features.'],
  ['Your data', 'JSON files on your disk. Open them in any editor.', 'Local, with optional cloud sync on Pro.'],
  ['AI', 'Your own model: Ollama on your Mac by default, any OpenAI-compatible server, the Anthropic API, or Claude Code with your Claude plan.', 'Raycast AI with hosted models, on Pro.'],
  ['Source code', 'Open. Read it, fork it, fix it.', 'Closed.'],
  ['Extensions', 'Script Commands (Raycast-compatible). No store.', 'Thousands in the Store. This is where Raycast shines.'],
  ['Install', 'Homebrew builds it from source on your Mac.', 'Signed, notarized download.'],
  ['Footprint', 'One process, 8.5 MB on disk.', 'Several processes, 242 MB on disk.'],
];
const views = [
  ['Search', 'search', 'Apps, commands and files in a single field, with math and currency conversion on the same line.'],
  ['Actions', 'panel', 'Press ⌘K for actions: aliases, a hotkey for any command, favorites and more.'],
  ['Clipboard', 'clipboard', 'Text, links, colors, files and images. Pin what matters; password managers are ignored.'],
  ['Snippets', 'snippets', 'Type a keyword and it expands as you write, with placeholders like {date}, {clipboard} and {cursor}.'],
  ['Ask AI', 'ai', 'Chat with Ollama, LM Studio, OpenAI, the Anthropic API or Claude Code. Answers stream in; keys stay in the Keychain.'],
  ['Settings', 'settings', 'Six tabs, plain-language descriptions, and an AI tab that tests the connection to your model server.'],
];
const extras = [
  ['Script Commands', 'Turn any script into a command. Works with Raycast Script Commands in full, compact, silent and inline modes.'],
  ['Quicklinks', 'Links with arguments. Type a few letters and land exactly where you meant to go.'],
  ['Window management', 'Halves, thirds, corners, center, and move between displays. About 40 commands.'],
  ['Currency, time zones and history', 'ECB exchange rates and time zone conversion in the search box, with a history of your last calculations.'],
  ['Files, windows and processes', 'Find files with Spotlight, jump between open windows, and kill a runaway process.'],
  ['Hotkeys and aliases', 'Give any app or command its own shortcut or short name, and keep favorites close.'],
  ['Timers, notes and emoji', 'Type timer 10m or pomodoro and get a notification when it ends. Jot a note, paste any emoji by name.'],
  ['Backup', 'Export your data and import snippets as JSON. Your setup travels with you.'],
];
const keys = [
  [['⌥', 'Space'], 'Open or close Ferrocast. You can change it in Settings.'],
  [['↑', '↓'], 'Move the selection.'],
  [['↵'], 'Run the primary action.'],
  [['⌘', '↵'], 'Run the secondary action.'],
  [['⌘', 'K'], 'Open the action panel for the selected item.'],
  [['⌘', ','], 'Open Settings.'],
  [['⌘', 'N'], 'New snippet, quicklink or note in those lists.'],
  [['⇧', '⌘', 'F'], 'Add or remove a favorite.'],
  [['⇧', '⌘', ','], 'Set a hotkey for a command.'],
  [['esc'], 'Clear the search, go back, or close.'],
  [['⌃', 'X'], 'Delete the selected entry.'],
  [['⌘', 'Y'], 'Quick Look the selected file.'],
  [['⌘', '.'], 'Pin or unpin a clipboard entry.'],
  [['⌘', 'E'], 'Edit the selected snippet or quicklink.'],
  [['⌫'], 'Go back when the search is empty.'],
];
const scText = ['#!/bin/bash', '# @raycast.mode compact', 'date +%H:%M'].join('\n');
const faq = [
  ['How do I open it?', 'Press ⌥ Space from any app. You can change the shortcut in Settings.'],
  ['Is it free?', 'Completely. MIT licence, no account, no Pro tier waiting behind a paywall. If it saves you time, star the repo.'],
  ['Will it run on my Mac?', 'It runs on Apple Silicon Macs. Intel Macs are not supported.'],
  ['Do I need to be a developer to install it?', 'No, but you do need to open Terminal once and paste four lines. Homebrew does the rest. Grab a coffee while it builds.'],
  ['Why does it ask for Accessibility access?', 'Because moving windows, pasting for you and expanding snippets all need it. Search, the calculator and AI work without it. A welcome screen walks you through it.'],
  ['Is my clipboard history private?', 'It never leaves your Mac. It sits in a JSON file in Application Support, and anything copied from a password manager like 1Password is skipped on purpose.'],
  ['Does Ask AI send my text to the cloud?', 'Only if you tell it to. Out of the box it talks to Ollama on your own Mac. Point it at LM Studio, OpenAI or the Anthropic API if you prefer; keys go in the Keychain.'],
  ['Can I use my ChatGPT or Claude subscription?', 'Not directly: those subscriptions do not include API access, and their sign-in tokens are not for third-party apps. If you have Claude Code installed and signed in, Ferrocast can use it as a provider, since it is Anthropic’s own tool running on your Mac.'],
  ['Coming from Raycast. Will my stuff work?', 'Your Script Commands run as they are, and snippets import from a JSON export. Quicklinks you recreate in a minute.'],
  ['What is missing today?', 'Honestly: an extension store and sync between Macs. If you live inside Raycast extensions, Ferrocast is not a drop-in replacement yet.'],
];
const install = `brew tap drumst0ck/ferrocast \\
  ${repo}
brew install ferrocast
ln -sfn "$(brew --prefix)/opt/ferrocast/Ferrocast.app" \\
  /Applications/Ferrocast.app
open /Applications/Ferrocast.app`;
const source = `git clone ${repo}
cd ferrocast
scripts/bundle.sh
open dist/Ferrocast.app`;
---
<Base title="Ferrocast: a fast launcher for your Mac" description="Ferrocast is a fast, native launcher for macOS. Search apps, do math, convert currencies, paste from your clipboard history, manage windows and ask AI, all from the keyboard.">
  <a class="skip" href="#main">Skip to content</a>
  <div class="cursor-light" aria-hidden="true"></div>
  <header class="top">
    <a class="mark" href="#"><img src={`${base}/icon.png`} alt="" width="30" height="30" />Ferrocast</a>
    <nav class="nav" aria-label="Main"><a href="#why">Why</a><a href="#features">Features</a><a href="#tour">Tour</a><a href="#shortcuts">Shortcuts</a><a href="#install">Install</a><a href="#faq">FAQ</a><a href={repo}>GitHub</a></nav>
    <a class="btn" href="#install">Install</a>
  </header>

  <main id="main">
    <section class="hero" aria-label="Introduction">
      <div class="hero-bg" aria-hidden="true"><i></i><i></i></div>
      <div class="copy">
        <h1 class="lines"><span class="line"><span data-line style="--i:0">Launch, calculate,</span></span><span class="line"><span data-line style="--i:1">paste and ask.</span></span></h1>
        <p class="sub" data-rise style="--i:3">Ferrocast is a small, open-source launcher for the Mac. Hit ⌥ Space, type half a word, and the thing you wanted is already there. No account, no subscription, nothing phoning home.</p>
        <div class="acts" data-rise style="--i:4"><a class="btn big" href="#install">Install with Homebrew</a><a class="tl" href={repo}>View on GitHub</a></div>
        <p class="proof" data-rise style="--i:5">Apple Silicon · MIT licence · Made by one person who got tired of waiting for menus</p>
      </div>
      <div class="hero-3d" data-rise style="--i:2">
        <canvas id="keys" aria-hidden="true"></canvas>
        <img class="fb" src={`${base}/icon.png`} alt="" width="256" height="256" />
      </div>
    </section>

    <section class="stage" aria-label="Live demo">
      <div class="lzwrap"><div class="lz" data-ui id="lz">
        <label class="sr-only" for="lzq">Search Ferrocast</label>
        <input class="lz-in" id="lzq" type="text" placeholder="Search apps, commands, files… or calculate" autocomplete="off" spellcheck="false" value="100 usd in eur" />
        <div class="lz-body" id="lzb" aria-live="polite"></div>
        <div class="lz-foot"><span>Ferrocast</span><span><b id="lzact">Copy Answer</b><kbd>↵</kbd><b style="margin-left:18px">Actions</b><kbd>⌘K</kbd></span></div>
      </div></div>
      <div class="tryrow" data-reveal role="group" aria-label="Examples">
        <button type="button" data-q="100 usd in eur">100 usd in eur</button>
        <button type="button" data-q="5pm ldn in sf">5pm ldn in sf</button>
        <button type="button" data-q="time in tokyo">time in tokyo</button>
        <button type="button" data-q="18% of 240">18% of 240</button>
        <button type="button" data-q="5 km in mi">5 km in mi</button>
        <button type="button" data-q="left half">left half</button>
      </div>
    </section>

    <section class="credo wrap" aria-labelledby="h-credo">
      <h2 class="sr-only" id="h-credo">Why Ferrocast</h2>
      <p data-reveal>We did not build this to shave seconds off your day. We built it because every little wait, every menu you have to hunt through, costs you the thought you were holding. Ferrocast shows up, answers, and gets out of the way before you notice it was there.</p>
    </section>

    <section class="why wrap" id="why" aria-labelledby="h-why">
      <div class="why-head" data-reveal>
        <h2 id="h-why">Why not just use Raycast?</h2>
        <p>Fair question. Raycast is a great product; we used it for years, and it is the yardstick we hold this one against. Ferrocast is for the days you would rather own the tool than rent it: no account, no tier, your data in files you can read, and an AI that runs on your own machine. If you live inside Raycast extensions, stay there. If you mostly launch, calculate, paste and move windows, this does that, and it is yours.</p>
      </div>
      <div class="cmp" role="table" aria-label="Ferrocast compared with Raycast">
        <div class="cmp-row cmp-head" role="row"><span role="columnheader"></span><span role="columnheader">Ferrocast</span><span role="columnheader">Raycast</span></div>
        {compare.map(([k, a, b], i) => <div class="cmp-row" role="row" data-reveal style={`transition-delay:${i * 40}ms`}><span role="rowheader">{k}</span><span role="cell">{a}</span><span role="cell" class="muted">{b}</span></div>)}
      </div>
      <p class="fine" data-reveal>Raycast facts are from raycast.com and its pricing page as of {bench.date}. If something is out of date, open an issue and we will fix it.</p>
    </section>

    <section class="stats" aria-label="Ferrocast at a glance">
      <dl>
        <div data-reveal><dt>2 keys</dt><dd>⌥ Space, from anywhere. Change it if you like.</dd></div>
        <div data-reveal style="transition-delay:80ms"><dt>~40</dt><dd>Ways to throw a window exactly where you want it.</dd></div>
        <div data-reveal style="transition-delay:160ms"><dt>Local</dt><dd>Your history, snippets and notes stay on your disk, in plain JSON.</dd></div>
        <div data-reveal style="transition-delay:240ms"><dt>MIT</dt><dd>Free, open source, and yours to fork.</dd></div>
      </dl>
    </section>

    <section class="bench wrap" id="speed" aria-labelledby="h-bench">
      <div class="why-head" data-reveal>
        <h2 id="h-bench">Measured, not promised</h2>
        <p>We measured both apps on the same Mac, in the same minute, with the same commands. The honest summary: on disk Ferrocast is a rounding error next to Raycast, in memory they are about the same, Ferrocast draws its first frame in under a fifth of a second, and once it is running the launcher answers a hotkey in about two milliseconds. Raycast does far more than we do, and its extension runtime is part of what you see below, so read this as what you pay for what you get, not as a scoreboard.</p>
      </div>
      <div class="cmp" role="table" aria-label="Footprint measured on the same Mac">
        <div class="cmp-row cmp-head" role="row"><span role="columnheader"></span><span role="columnheader">Ferrocast</span><span role="columnheader">Raycast {bench.raycastVersion}</span></div>
        <div class="cmp-row" role="row" data-reveal><span role="rowheader">App on disk</span><span role="cell"><b>{bench.ferro.disk}</b></span><span role="cell" class="muted">{bench.ray.disk}</span></div>
        <div class="cmp-row" role="row" data-reveal style="transition-delay:40ms"><span role="rowheader">Memory at idle</span><span role="cell"><b>{bench.ferro.mem}</b></span><span role="cell" class="muted">{bench.ray.mem}</span></div>
        <div class="cmp-row" role="row" data-reveal style="transition-delay:80ms"><span role="rowheader">Processes</span><span role="cell"><b>{bench.ferro.procs}</b></span><span role="cell" class="muted">{bench.ray.procs}</span></div>
        <div class="cmp-row" role="row" data-reveal style="transition-delay:120ms"><span role="rowheader">Hotkey to drawn frame</span><span role="cell"><b>about 2 ms</b></span><span role="cell" class="muted">not measured</span></div>
        <div class="cmp-row" role="row" data-reveal style="transition-delay:160ms"><span role="rowheader">Keystroke to new results</span><span role="cell"><b>0.1 to 0.3 ms</b></span><span role="cell" class="muted">not measured</span></div>
        <div class="cmp-row" role="row" data-reveal style="transition-delay:200ms"><span role="rowheader">Cold start to first frame</span><span role="cell"><b>{bench.ferro.start}</b></span><span role="cell" class="muted">{bench.ray.start}</span></div>
      </div>
      <p class="fine" data-reveal>Method: {bench.mac}, {bench.date}. Disk is <code>du -sh</code> of the app bundle. Memory is resident size from <code>ps -axo rss</code>, summed over every process the app runs, with both apps idle and their windows shown. Hotkey to frame is the time from the show call to the next frame the app draws (1.6 to 2.6 ms; the display adds its own refresh on top). Keystroke to results is how long the list takes to recompute for queries like “100 usd in eur”. Cold start is process launch to first rendered frame over five launches (136 to 167 ms), almost all of it macOS creating the window. None of these could be measured for Raycast fairly from the outside, so those cells stay blank rather than guessed. Your numbers will differ.</p>
    </section>

    <section class="feat wrap" id="features" aria-labelledby="h-feat">
      <h2 class="sr-only" id="h-feat">What it does</h2>
      <p class="big" data-reveal>Type a few letters and the app opens <span class="slot"><img src={`${base}/slot/home.jpg`} alt="" width="381" height="147" loading="eager" /></span>. Type a sum, a currency or a time zone and the answer is right there <span class="slot"><img src={`${base}/slot/tz.jpg`} alt="" width="381" height="147" loading="eager" /></span>. Everything you copy waits in your history <span class="slot"><img src={`${base}/slot/clipboard.jpg`} alt="" width="381" height="147" loading="eager" /></span>. And when you need a second brain, ask your own AI <span class="slot"><img src={`${base}/slot/ai.jpg`} alt="" width="381" height="147" loading="eager" /></span>, running on your Mac or wherever you point it.</p>
      <div class="more" data-reveal>
        <p>One window for apps, files, maths, currencies, time zones, clipboard history, snippets, windows, emoji, timers and notes. Everything lives in a few JSON files you can open with a text editor.</p>
        <a class="btn" href="#install">Install with Homebrew</a>
      </div>
    </section>

    <section class="story" id="tour" aria-labelledby="h-story" style={`--n:${views.length}`}>
      <div class="story-in">
        <div class="story-txt">
          <h2 class="sr-only" id="h-story">A tour of the app</h2>
          <ol class="steps">
            {views.map(([n, , d], i) => <li class:list={['step', { on: i === 0 }]} data-i={i}><h3>{n}</h3><p>{d}</p></li>)}
          </ol>
          <div class="dots" role="group" aria-label="Screens">
            {views.map(([n], i) => <button type="button" class:list={{ on: i === 0 }} data-i={i} aria-label={n}></button>)}
          </div>
        </div>
        <div class="story-vis">
          <div class="story-card" id="scard">
            {views.map(([n, f], i) => <img class:list={['sv', { on: i === 0 }]} data-i={i} src={img(f)} alt={`Real Ferrocast screenshot: ${n}`} width="1300" height="823" loading={i === 0 ? 'eager' : 'lazy'} />)}
          </div>
        </div>
      </div>
    </section>

    <section class="vid" aria-labelledby="h-vid">
      <div class="vid-head" data-reveal>
        <h2 id="h-vid">No mock-ups. This is the app.</h2>
        <p>We did not fake this in a design tool. Every frame is a screenshot the app took of itself while a query was typed.</p>
      </div>
      <div class="vstage" id="vstage">
        <div class="vwrap" id="vwrap">
          <video id="vplay" muted loop playsinline preload="none" poster={`${base}/video/poster.jpg`} aria-label="Ferrocast answering a currency conversion, a time zone question, a percentage and a window command">
            <source src={`${base}/video/ferrocast.mp4`} type="video/mp4" />
          </video>
        </div>
      </div>
    </section>

    <section class="more-list wrap" aria-labelledby="h-more">
      <h2 id="h-more" data-reveal>The small things you end up using every day</h2>
      <ul class="bento">
        {extras.map(([t, d], i) => <li class={`b${i}`} data-reveal style={`transition-delay:${(i % 3) * 70}ms`}><b>{t}</b><span>{d}</span>{i === 2 && <div class="snap" aria-hidden="true"><i></i></div>}{i === 0 && <code class="sc" aria-hidden="true">{scText}</code>}{i === 1 && <div class="ql" aria-hidden="true"><i class="k">gh</i><i>drumst0ck/ferrocast</i><em>→</em><i>github.com/drumst0ck/ferrocast</i></div>}{i === 3 && <div class="fx" aria-hidden="true">1 USD<em>→</em>0.92 EUR</div>}</li>)}
      </ul>
    </section>

    <section class="keys wrap" id="shortcuts" aria-labelledby="h-keys">
      <div class="keys-head" data-reveal>
        <h2 id="h-keys">Your hands never leave the keyboard</h2>
        <p>These are the ones worth learning first. Press ⌘ K on anything and it shows you the rest.</p>
      </div>
      <ul class="keylist">
        {keys.map(([combo, what], i) => <li data-reveal style={`transition-delay:${(i % 3) * 60}ms`}><span class="combo">{combo.map((k) => <kbd>{k}</kbd>)}</span><span>{what}</span></li>)}
      </ul>
    </section>

    <section class="how" id="install" aria-labelledby="h-how">
      <h2 id="h-how" data-reveal>Installed in the time it takes to make a coffee</h2>
      <div class="ex" data-reveal>
        <h3>Paste this into Terminal.</h3>
        <div class="call"><pre><code id="inst">{install}</code></pre><button class="cp" type="button" data-copy="inst">Copy</button></div>
        <p class="note">Homebrew builds Ferrocast from source on your own Mac, which is why the first install takes a few minutes and why there is no Gatekeeper warning: nothing you did not compile ever runs. Apple Silicon only, for now.</p>
      </div>
      <div class="ex" data-reveal>
        <h3>Open it once and say yes to Accessibility.</h3>
        <div class="call"><span class="typed">⌥ Space</span></div>
        <div class="resp crop"><img src={img('home')} alt="Ferrocast just opened, showing the command list" width="1300" height="823" loading="lazy" /></div>
      </div>
      <div class="ex wide" data-reveal>
        <h3>Then just start typing.</h3>
        <div class="call"><span class="typed">5pm ldn in sf</span></div>
        <div class="resp"><img src={img('tz')} alt="Ferrocast answers that 5 PM in London is 9:00 AM in San Francisco" width="1300" height="823" loading="lazy" /></div>
      </div>
    </section>

    <section class="faq" id="faq" aria-labelledby="h-faq">
      <ul class="fl">
        <li class="fh" id="h-faq">Things people ask us</li>
        {faq.map(([q, a], i) => <li><button type="button" aria-expanded={i === 0 ? 'true' : 'false'} data-i={i}>{q}</button><p class="ans">{a}</p></li>)}
      </ul>
      <p class="fp" id="fp" aria-live="polite">{faq[0][1]}</p>
    </section>

    <section class="cta" aria-labelledby="h-cta">
      <div class="l">
        <h2 id="h-cta" class="lines"><span class="line"><span data-line style="--i:0">Try it</span></span><span class="line"><span data-line style="--i:1">today.</span></span></h2>
        <p data-reveal>Four lines in Terminal, a few minutes of compiling, and ⌥ Space is yours. If it does not stick, brew uninstall it and nothing is left behind.</p>
      </div>
      <div class="dlg" data-ui data-reveal>
        <h3>Install Ferrocast</h3>
        <div class="seg" role="group" aria-label="Method"><button type="button" aria-pressed="true" data-m="brew">Homebrew</button><button type="button" aria-pressed="false" data-m="src">From source</button></div>
        <pre><code id="dlgcode">{install}</code></pre>
        <button class="btn" type="button" id="dlgcp">Copy commands</button>
        <small>MIT licence. The whole thing is on GitHub, issues welcome.</small>
      </div>
    </section>
  </main>

  <footer class="foot">
    <span data-reveal>A fast launcher for macOS</span>
    <nav aria-label="Links"><a href="#install">Install</a><a href={repo}>GitHub</a><a href={`${base}/changelog/`}>Changelog</a><a href={`${repo}/blob/main/LICENSE`}>License</a></nav>
    <span class="r">2026 · MIT</span>
  </footer>

  <script is:inline define:vars={{ install, source, faq: faq.map((f) => f[1]), descs: views.map((v) => v[2]) }}>
    (function () {
      var $ = function (s, r) { return (r || document).querySelector(s); }, $$ = function (s, r) { return Array.prototype.slice.call((r || document).querySelectorAll(s)); };
      /* copy buttons */
      function copy(text, btn, done) { var ok = function () { var o = btn.textContent; btn.textContent = done; setTimeout(function () { btn.textContent = o; }, 1600); }; if (navigator.clipboard) navigator.clipboard.writeText(text).then(ok, ok); else ok(); }
      $$('[data-copy]').forEach(function (b) { b.addEventListener('click', function () { copy($('#' + b.dataset.copy).textContent, b, 'Copied'); }); });
      /* cta dialog */
      var code = $('#dlgcode'), mode = 'brew';
      $$('.seg button').forEach(function (b) { b.addEventListener('click', function () { mode = b.dataset.m; code.textContent = mode === 'brew' ? install : source; $$('.seg button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); }); }); });
      $('#dlgcp').addEventListener('click', function () { copy(code.textContent, $('#dlgcp'), 'Copied'); });
      /* pinned story: scroll chooses the screen, 3D card sweeps */
      var story = $('.story'), steps = $$('.step'), svs = $$('.sv'), dots = $$('.dots button'), scard = $('#scard'), n = steps.length, cur = -1, sp = 0, sx = 0, sy = 0, stx = 0, sty = 0;
      function setStep(i) { if (i === cur) return; cur = i; steps.forEach(function (e, k) { e.classList.toggle('on', k === i); }); svs.forEach(function (e, k) { e.classList.toggle('on', k === i); }); dots.forEach(function (e, k) { e.classList.toggle('on', k === i); }); }
      function storyFrame() {
        var r = story.getBoundingClientRect(), span = r.height - innerHeight, p = Math.min(1, Math.max(0, -r.top / span));
        sp += (p - sp) * 0.12; sx += (stx - sx) * 0.08; sy += (sty - sy) * 0.08;
        setStep(Math.min(n - 1, Math.floor(p * n * 0.999)));
        if (!reduce) scard.style.transform = 'rotateY(' + (-16 + sp * 26 + sx * 6).toFixed(2) + 'deg) rotateX(' + (7 - sp * 5 - sy * 4).toFixed(2) + 'deg) translateZ(0)';
        if (r.bottom > 0 && r.top < innerHeight) requestAnimationFrame(storyFrame);
      }
      var storyOn = false;
      new IntersectionObserver(function (en) { var v = en[0].isIntersecting; if (v && !storyOn) { storyOn = true; storyFrame(); } if (!v) storyOn = false; }, { threshold: 0 }).observe(story);
      story.addEventListener('pointermove', function (e) { var r = story.getBoundingClientRect(); stx = ((e.clientX / innerWidth) - 0.5) * 2; sty = ((e.clientY / innerHeight) - 0.5) * 2; });
      dots.forEach(function (d, i) { d.addEventListener('click', function () { var top = story.getBoundingClientRect().top + scrollY, span = story.offsetHeight - innerHeight; scrollTo({ top: top + ((i + 0.5) / n) * span, behavior: reduce ? 'auto' : 'smooth' }); }); });

      /* faq */
      var fb = $$('.fl button'), fp = $('#fp');
