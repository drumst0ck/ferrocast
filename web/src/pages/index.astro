---
import Base from '../layouts/Base.astro';
import Launcher from '../components/Launcher.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repo = 'https://github.com/drumst0ck/ferrocast';
const features = [
  ['Búsqueda raíz', 'Apps y comandos con ranking por frecuencia, alias y favoritos.'],
  ['Calculadora y conversor', 'Mates, porcentajes, unidades, colores y divisas (tasas del BCE).'],
  ['Husos horarios', 'Escribe «time in tokyo» o «5pm ldn in sf» y obtén la hora al instante.'],
  ['Portapapeles', 'Historial de texto, archivos e imágenes con pin; ignora gestores de contraseñas.'],
  ['Snippets', 'Placeholders y auto-expansión mientras escribes en cualquier app.'],
  ['Quicklinks', 'Enlaces con argumentos para saltar a donde quieras en un atajo.'],
  ['Script Commands', 'Compatibles con Raycast: modos full, compact, silent e inline.'],
  ['Ventanas', 'Unos 40 comandos para colocar y mover ventanas con el teclado.'],
  ['Ask AI', 'Streaming y conversación con Ollama, LM Studio u OpenAI; la clave vive en el Keychain.'],
];
const faq = [
  ['¿Es una copia de Raycast?', 'No. Está inspirado en él, pero no usa su marca ni sus assets, y no pretende ser una réplica completa.'],
  ['¿Por qué se instala con Homebrew y compila?', 'El cask oficial exige apps firmadas y notarizadas (cuenta de pago). Al compilar en tu Mac no hay cuarentena y Gatekeeper no interviene.'],
  ['¿Qué permisos necesita?', 'Accesibilidad (y Input Monitoring para snippets). Los concedes tú la primera vez desde la pantalla de bienvenida.'],
  ['¿Dónde se guardan mis datos?', 'En JSON sin cifrar en ~/Library/Application Support/Ferrocast. Puedes cambiarlo con FERROCAST_DATA_DIR.'],
];
const install = `brew tap drumst0ck/ferrocast ${repo}
brew install ferrocast
ln -sfn "$(brew --prefix)/opt/ferrocast/Ferrocast.app" /Applications/Ferrocast.app
open /Applications/Ferrocast.app`;
---
<Base title="Ferrocast — launcher para macOS escrito en Rust" description="Ferrocast es un launcher para macOS escrito en Rust, inspirado en Raycast: búsqueda, calculadora, portapapeles, snippets, ventanas y Ask AI.">
  <header class="wrap nav">
    <a class="brand" href="#"><img src={`${base}/icon.png`} alt="" width="32" height="32" />Ferrocast</a>
    <nav><a href="#funciones">Funciones</a><a href="#instalar">Instalar</a><a href="#faq">FAQ</a><a href={repo}>GitHub</a></nav>
  </header>

  <main>
    <section class="wrap hero">
      <div>
        <p class="eyebrow">macOS · Apple Silicon · Rust</p>
        <h1>Tu Mac, a un atajo de distancia.</h1>
        <p class="lead">Un launcher rápido y nativo en Rust. Busca, calcula, pega, organiza ventanas y pregunta a una IA local sin quitar las manos del teclado.</p>
        <div class="cta">
          <a class="btn primary" href="#instalar">Instalar con Homebrew</a>
          <a class="btn" href={repo}>Ver código</a>
        </div>
        <p class="hint">Atajo por defecto: <kbd>⌥</kbd> <kbd>Space</kbd></p>
      </div>
      <Launcher />
    </section>

    <section id="funciones" class="wrap block">
      <h2>Todo lo que haces veinte veces al día</h2>
      <div class="grid">
        {features.map(([t, d]) => <article><h3>{t}</h3><p>{d}</p></article>)}
      </div>
      <p class="note">Aún no incluye extensiones React, sincronización ni contexto de IA por selección o pantalla.</p>
    </section>

    <section id="instalar" class="wrap block">
      <h2>Instalar</h2>
      <p class="sub">Sin cuenta de desarrollador: la fórmula compila en tu Mac (necesita Rust; brew lo instala). La primera vez tarda unos minutos.</p>
      <pre><code>{install}</code></pre>
      <p class="sub">Concede Accesibilidad cuando lo pida. Para actualizar: <code>brew upgrade ferrocast</code>.</p>
    </section>

    <section id="faq" class="wrap block">
      <h2>Preguntas frecuentes</h2>
      <div class="faq">
        {faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
      </div>
    </section>
  </main>

  <footer class="wrap foot">
    <span>Ferrocast · Licencia MIT</span>
    <a href={repo}>github.com/drumst0ck/ferrocast</a>
  </footer>
</Base>

<style>
  .nav { display: flex; justify-content: space-between; align-items: center; padding-block: 20px; }
  .brand { display: flex; align-items: center; gap: 10px; font-weight: 700; text-decoration: none; }
  .brand img { border-radius: 8px; }
  nav { display: flex; gap: 22px; font-size: .95rem; color: var(--mute); }
  nav a { text-decoration: none; } nav a:hover { color: var(--ink); }
  .hero { display: grid; grid-template-columns: 1.05fr .95fr; gap: 56px; align-items: center; padding-block: 72px 96px; }
  .eyebrow { font-family: var(--mono); font-size: .8rem; color: var(--accent); text-transform: uppercase; letter-spacing: .08em; margin-bottom: 18px; }
  h1 { font-size: clamp(2.6rem, 6vw, 4.6rem); line-height: 1.02; letter-spacing: -.035em; }
  .lead { color: var(--mute); font-size: 1.15rem; margin: 22px 0 30px; max-width: 46ch; }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; }
  .hint { color: var(--mute); margin-top: 20px; font-size: .9rem; }
  .block { padding-block: 64px; border-top: 1px solid var(--line); }
  h2 { font-size: clamp(1.7rem, 3.5vw, 2.4rem); letter-spacing: -.025em; margin-bottom: 32px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: 16px; overflow: hidden; }
  article { background: var(--bg); padding: 26px; }
  article h3 { font-size: 1.05rem; margin-bottom: 6px; }
  article p, .sub, .note { color: var(--mute); }
  .note { margin-top: 20px; font-size: .9rem; }
  .sub { max-width: 70ch; margin-bottom: 18px; }
  pre { background: var(--panel); border: 1px solid var(--line); border-radius: 14px; padding: 22px; overflow-x: auto; margin-bottom: 18px; font-size: .9rem; line-height: 1.7; }
  .faq { display: grid; gap: 10px; max-width: 800px; }
  details { border: 1px solid var(--line); border-radius: 12px; padding: 16px 20px; background: var(--panel); }
  summary { cursor: pointer; font-weight: 600; }
  details p { color: var(--mute); margin-top: 10px; }
  .foot { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; padding-block: 40px; border-top: 1px solid var(--line); color: var(--mute); font-size: .9rem; }
  .foot a { text-decoration: none; }
  @media (max-width: 860px) { .hero { grid-template-columns: 1fr; padding-block: 40px 64px; } nav a:not(:last-child) { display: none; } }
</style>
