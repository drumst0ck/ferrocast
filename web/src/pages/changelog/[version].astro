---
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ChangelogEntries from '../../components/ChangelogEntries.astro';
import { loadRelease, versionLabel } from '../../lib/changelog/load';

export const prerender = false;

const { version = '' } = Astro.params;
const { release, ok } = await loadRelease(version.toLowerCase());
if (!ok) Astro.response.status = 503;
else if (!release) return new Response(null, { status: 404, headers: { Location: '/changelog/' } });
const r = release!;
const first = r.entries.find((e) => e.category === 'added');
const description = (r.summary ?? `Ferrocast ${versionLabel(r.version)}: ${r.entries.length} changes${first ? `, including ${first.title ?? first.bodyMd.slice(0, 60)}` : ''}.`).slice(0, 155);
const canonical = new URL(`/changelog/${r.version}/`, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Ferrocast',
  operatingSystem: 'macOS',
  applicationCategory: 'UtilitiesApplication',
  softwareVersion: r.version,
  releaseNotes: canonical,
  ...(r.releasedOn ? { datePublished: r.releasedOn } : {}),
};
---
<Base title={`Ferrocast ${versionLabel(r.version)} release notes`} description={description} canonical={canonical} jsonLd={jsonLd}>
  <SiteHeader />
  <main class="wrap prose" id="main">
    <p class="muted"><a class="tl" href="/changelog/">← All releases</a></p>
    <h1>Ferrocast {versionLabel(r.version)}</h1>
    {r.releasedOn && <p class="muted"><time datetime={r.releasedOn}>{r.releasedOn}</time></p>}
    {r.summary && <p class="muted">{r.summary}</p>}
    <ChangelogEntries entries={r.entries} />
  </main>
  <SiteFooter />
</Base>
<style is:global>
  .prose { max-width: 760px; margin: clamp(40px, 6vw, 80px) auto 0; display: grid; gap: 18px; }
  .prose h1 { font-size: var(--step-head); line-height: 1; margin-bottom: 12px; }
  .prose p { color: var(--muted); }
</style>
